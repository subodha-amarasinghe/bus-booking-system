{
  "name": "passenger-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/passenger-web",
  "projectType": "application",
  "tags": ["scope:passenger", "platform:web"],
  "// targets": "to see all targets run: nx show project passenger-web --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/passenger-web"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 3200",
        "cwd": "apps/passenger-web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start -p 3200",
        "cwd": "apps/passenger-web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next lint",
        "cwd": "apps/passenger-web"
      }
    }
  }
}
