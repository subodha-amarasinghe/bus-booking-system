generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Cancellation {
  id        String   @id @default(uuid())
  bookingId String
  userId    String
  reason    String?
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refund    Refund?
}

model Refund {
  id             String    @id @default(uuid())
  bookingId      String
  paymentId      String?
  userId         String
  cancellationId String    @unique
  amount         Float
  currency       String    @default("LKR")
  status         String    @default("PENDING")
  reason         String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cancellation   Cancellation @relation(fields: [cancellationId], references: [id])
}

/// Operator-configured refund tiers shown to passengers and used when quoting.
model CancellationPolicy {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// JSON array of { minHoursBeforeDeparture, refundPercent, label? }
  rules       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
