generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  ADMIN_STAFF
  CUSTOMER_STAFF
}

model UserCredential {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  role         UserRole @default(PASSENGER)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
