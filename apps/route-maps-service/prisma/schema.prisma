generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String   @id @default(uuid())
  name      String
  code      String?
  latitude  Float
  longitude Float
  city      String?
  district  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  origins   Route[]  @relation("RouteOrigin")
  destinations Route[] @relation("RouteDestination")
}

model Route {
  id                    String   @id @default(uuid())
  name                  String
  originLocationId      String
  destinationLocationId String
  distanceKm            Float?
  estimatedDurationMin  Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  origin                Location @relation("RouteOrigin", fields: [originLocationId], references: [id])
  destination           Location @relation("RouteDestination", fields: [destinationLocationId], references: [id])
}
