# ── Shared ──────────────────────────────────────────────
# NODE_ENV is intentionally omitted here; Next.js sets it to "production" during builds.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ── Message broker / cache ──────────────────────────────
RABBITMQ_URL=amqp://bus:bus@localhost:5672
REDIS_URL=redis://localhost:6379
OSRM_BASE_URL=https://router.project-osrm.org

# ── Per-service Postgres (host ports mapped from docker-compose) ──
AUTH_DATABASE_URL=postgresql://bus:bus@localhost:5433/auth_db
USER_DATABASE_URL=postgresql://bus:bus@localhost:5434/user_db
ROUTE_MAPS_DATABASE_URL=postgresql://bus:bus@localhost:5435/route_maps_db
BUS_SEAT_DATABASE_URL=postgresql://bus:bus@localhost:5436/bus_seat_db
BOOKING_DATABASE_URL=postgresql://bus:bus@localhost:5437/booking_db
PAYMENT_DATABASE_URL=postgresql://bus:bus@localhost:5438/payment_db
MODIFICATION_DATABASE_URL=postgresql://bus:bus@localhost:5439/modification_db
NOTIFICATION_DATABASE_URL=postgresql://bus:bus@localhost:5440/notification_db

# ── Service ports ───────────────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ROUTE_MAPS_SERVICE_PORT=3003
BUS_SEAT_SERVICE_PORT=3004
BOOKING_SERVICE_PORT=3020
PAYMENT_SERVICE_PORT=3006
MODIFICATION_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
DASHBOARD_PORT=3100
PASSENGER_WEB_PORT=3200

# ── Upstream URLs (local Nx serve) ──────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
ROUTE_MAPS_SERVICE_URL=http://localhost:3003
BUS_SEAT_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3020
PAYMENT_SERVICE_URL=http://localhost:3006
MODIFICATION_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008

# ── Dashboard / passenger-web (Next.js) ─────────────────
API_GATEWAY_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=http://localhost:3020

# ── Passenger mobile (Expo) ─────────────────────────────
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:3000/api
EXPO_PUBLIC_BOOKING_WS_URL=http://localhost:3020

# ── Payment provider (local stub checkout) ──────────────
PAYMENT_PROVIDER_URL=http://localhost:3006/checkout
PAYMENT_PROVIDER_KEY=pk_test_local_bus_booking_dev

# ── Notification / SMTP (Mailhog / Mailpit defaults) ────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=bus-booking
SMTP_PASS=bus-booking
